# Port exposed on the host. Example: http://localhost:3100
APP_PORT=3100

# Application port inside the container. Can be changed without rebuilding.
PORT=3000

# Set 127.0.0.1 when only a reverse proxy on this host should access the app.
BIND_ADDRESS=0.0.0.0

# Image name/tag used by Docker Compose.
APP_IMAGE=ant-play:latest

TZ=Asia/Ho_Chi_Minh

# Public origin of this portal, used at BUILD time for canonical/OG/sitemap.
SITE_URL=http://localhost:3100

# --- Runtime (đổi xong chỉ cần tạo lại container, không cần build lại) ---
# Địa chỉ API (web-game-server) mà server Next.js gọi tới, KHÔNG có /api/v1 ở cuối.
# Chạy trong Docker thì phải là địa chỉ container truy cập được (vd http://api:3000 cùng network,
# hoặc http://host.docker.internal:3000 khi API chạy trên máy host) — không dùng localhost.
API_INTERNAL_URL=http://localhost:3000
# Chuỗi bí mật dùng chung với API để gọi POST /api/revalidate (header x-revalidate-secret).
# Phải trùng với REVALIDATE_SECRET bên API. Dùng cho webhook /api/revalidate và proxy đếm lượt chơi /api/play (gửi IP người chơi để API giới hạn theo từng người).
REVALIDATE_SECRET=change-me-to-a-long-random-string
