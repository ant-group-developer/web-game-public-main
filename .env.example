# Port exposed on the host. Example: http://localhost:3100
APP_PORT=3100

# Application port inside the container. Can be changed without rebuilding.
PORT=3000

# Set 127.0.0.1 when only a reverse proxy on this host should access the app.
BIND_ADDRESS=0.0.0.0

# Image name/tag used by Docker Compose.
APP_IMAGE=ant-play:latest

TZ=Asia/Ho_Chi_Minh

# Public origin of this portal, used at BUILD time for canonical/OG/sitemap.
SITE_URL=http://localhost:3100
# URL iframe của từng game (đóng vào build — đổi xong phải build lại).
# Apple Worm: dùng /embed/apple-worm nếu muốn chạy bản game đi kèm cùng domain.
NEXT_PUBLIC_APPLE_WORM_EMBED_URL=https://apple-worm.antfootage.net/embed/apple-worm
NEXT_PUBLIC_CITY_BLOXX_EMBED_URL=https://citybloxx.antfootage.net/embed?screen=quick
NEXT_PUBLIC_LUDO_EMBED_URL=https://ludo.antfootage.net/
NEXT_PUBLIC_BLOCK_PUZZLE_EMBED_URL=https://block-puzzle.antfootage.net/play
NEXT_PUBLIC_XO_EMBED_URL=https://xo.antfootage.net/
NEXT_PUBLIC_XIANGQI_EMBED_URL=https://co-tuong.antfootage.net/
